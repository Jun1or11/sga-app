<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="8dp"
    android:paddingEnd="20dp"
    android:paddingBottom="8dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="Elige cómo quieres que responda el escáner al detectar un producto."
        android:textColor="@color/on_surface_variant"
        android:textSize="13sp" />

    <Switch
        android:id="@+id/switch_escaner_sonido"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:text="Sonido al escanear"
        android:textColor="@color/on_surface"
        android:textSize="15sp" />

    <Switch
        android:id="@+id/switch_escaner_vibracion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:text="Vibración al escanear"
        android:textColor="@color/on_surface"
        android:textSize="15sp" />

    <Switch
        android:id="@+id/switch_escaner_abrir"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:text="Abrir la ficha del producto"
        android:textColor="@color/on_surface"
        android:textSize="15sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Si desactivas la apertura automática, el producto se agrega a la lista y puedes seguir escaneando."
        android:textColor="@color/on_surface_variant"
        android:textSize="12sp" />
</LinearLayout>
